# SkyNova Airways - Environment Configuration Placeholders
# DO NOT ADD REAL SECRETS OR KEYS TO THIS FILE.

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL for Docker/Production, H2 for zero-config local)
DATABASE_URL=jdbc:postgresql://localhost:5432/skynova_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace_with_local_db_password

# H2 Fallback Configuration (Used when SPRING_PROFILES_ACTIVE=h2)
H2_DATABASE_URL=jdbc:h2:mem:skynova_db;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE

# JWT Security Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Mock Payment Provider (Local Simulation)
PAYMENT_PROVIDER_MODE=MOCK
PAYMENT_MOCK_SUCCESS_RATE=1.0

# Mock Notification System
NOTIFICATION_PROVIDER_MODE=MOCK
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=mock_user
SMTP_PASSWORD=mock_pass

# Frontend App Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=SkyNova Airways
